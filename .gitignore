# ===========================================================================
# .gitignore — Django / PostgreSQL / Python / macOS
# ===========================================================================

# ── Entorno virtual ──────────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Variables de entorno (NUNCA commitear) ────────────────────────────────────
.env
.env.local
.env.production
.env.*.local

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt
*.egg-info/
*.egg
.eggs/
dist/
build/
wheels/
*.whl
*.spec

# ── Django ───────────────────────────────────────────────────────────────────
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
staticfiles/
media/
/logs/*.log

# Guarda el directorio de logs pero ignora su contenido
logs/
!logs/.gitkeep

# ── PostgreSQL ───────────────────────────────────────────────────────────────
*.dump
*.sql.gz
backups/

# ── IDEs y editores ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
.DocumentRevisions-V100
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# ── Coverage ─────────────────────────────────────────────────────────────────
.coverage
.coverage.*
htmlcov/
.tox/
.cache
nosetests.xml
coverage.xml
*.cover

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints
*.ipynb

# ── Misc ─────────────────────────────────────────────────────────────────────
*.bak
*.tmp
*.orig
