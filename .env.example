# ===========================================================================
# IMPERANDINA — Variables de entorno
# Copiar como .env y completar con valores reales.
# NUNCA commitear .env al repositorio.
# ===========================================================================

# ── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-cambia-esto-por-una-clave-aleatoria-segura
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Base de datos PostgreSQL ─────────────────────────────────────────────────
DB_NAME=presupuestos
DB_USER=imperandina_user
DB_PASSWORD=tu_password_seguro
DB_HOST=localhost
DB_PORT=5432

# ── Zona horaria y localización ──────────────────────────────────────────────
TIME_ZONE=America/Bogota
LANGUAGE_CODE=es-co

# ── Logging ──────────────────────────────────────────────────────────────────
# Niveles: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG
LOG_FILE=logs/imperandina.log

# ── Cache ────────────────────────────────────────────────────────────────────
# Backend: "locmem" (desarrollo) o "redis" (producción).
# Si CACHE_BACKEND=redis, debes definir REDIS_URL.
CACHE_BACKEND=locmem
# REDIS_URL=redis://127.0.0.1:6379/1

# ── Administrador inicial (Fase 12.3) ────────────────────────────────────────
# Usadas por: python manage.py ensure_default_admin
# El comando es idempotente y nunca sobrescribe la contraseña de un usuario ya
# existente. Valores de ejemplo — reemplazar por reales en el .env real.
ANDINACOST_ADMIN_EMAIL=admin@empresa.com
ANDINACOST_ADMIN_PASSWORD=cambiar-por-clave-fuerte
ANDINACOST_ADMIN_NAME=Administrador del sistema
# Unidad corporativa/técnica del administrador global (Fase 12.3 ext).
# EDILANDINA da identidad visual gris/negro/blanco al ADMINISTRADOR pero NO
# limita su alcance: el ADMINISTRADOR sigue viendo todas las unidades.
# Opciones: EDILANDINA, IMPERANDINA, SOLARANDINA, IMPERTIENDA.
ANDINACOST_ADMIN_UNIDAD=EDILANDINA
