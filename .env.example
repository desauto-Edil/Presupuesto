# ===========================================================================
# IMPERANDINA — Variables de entorno
# Copiar como .env y completar con valores reales.
# NUNCA commitear .env al repositorio.
# ===========================================================================

# ── Django (OBLIGATORIAS — el sistema no arranca sin ellas) ─────────────────
# Generar SECRET_KEY segura:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True solo para desarrollo local. SIEMPRE False en producción.
DEBUG=False

# Dominios separados por comas. Ej: tudominio.com,www.tudominio.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Base de datos PostgreSQL (OBLIGATORIA) ───────────────────────────────────
DB_NAME=presupuestos
DB_USER=imperandina_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── Zona horaria y localización ──────────────────────────────────────────────
TIME_ZONE=America/Bogota
LANGUAGE_CODE=es-co

# ── Logging ──────────────────────────────────────────────────────────────────
# Niveles: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Usar WARNING o ERROR en producción.
LOG_LEVEL=WARNING
LOG_FILE=logs/imperandina.log

# ── Cache ────────────────────────────────────────────────────────────────────
# Backend: "locmem" (desarrollo/primer despliegue) o "redis" (producción con carga).
# Si CACHE_BACKEND=redis, define también REDIS_URL.
CACHE_BACKEND=locmem
# REDIS_URL=redis://127.0.0.1:6379/1

# ── Seguridad HTTP (activar en producción con HTTPS) ────────────────────────
# Dejar en False mientras no haya certificado SSL configurado.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# HSTS: 31536000 = 1 año. Activar solo cuando SSL esté 100% estable.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# DENY bloquea iframes completamente. SAMEORIGIN los permite del mismo origen.
X_FRAME_OPTIONS=SAMEORIGIN

# ── Subida de archivos ───────────────────────────────────────────────────────
# Tamaño máximo en MB para archivos adjuntos de Solicitud.
MAX_UPLOAD_SIZE_MB=10

# ── Administrador inicial ─────────────────────────────────────────────────────
# Usadas por: python manage.py ensure_default_admin
# El comando es idempotente: no sobreescribe al admin si ya existe.
# Reemplazar por valores reales y seguros en el .env real.
ANDINACOST_ADMIN_EMAIL=
ANDINACOST_ADMIN_PASSWORD=
ANDINACOST_ADMIN_NAME=Administrador del sistema
# Opciones: EDILANDINA, IMPERANDINA, SOLARANDINA, IMPERTIENDA
ANDINACOST_ADMIN_UNIDAD=EDILANDINA
